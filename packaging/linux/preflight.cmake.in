if(NOT "@SECRET_FOUND@")
  message(FATAL_ERROR "Native Linux packages require libsecret-1 development files at configure time")
endif()
if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/bin/config.json")
  message(FATAL_ERROR "Launcher defaults are missing; use scripts/package-linux.py or build the launchers")
endif()
file(GLOB launchers "@CMAKE_CURRENT_BINARY_DIR@/bin/linux-*/JumpServerClient")
list(LENGTH launchers launcher_count)
if(NOT launcher_count EQUAL 1)
  message(FATAL_ERROR "Package exactly one Linux launcher architecture per clean build directory")
endif()
foreach(launcher IN LISTS launchers)
  get_filename_component(directory "${launcher}" DIRECTORY)
  if(NOT EXISTS "${directory}/client")
    message(FATAL_ERROR "SSH companion is missing from ${directory}")
  endif()
endforeach()
